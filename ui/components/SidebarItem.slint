// One row of the sidebar. `node.kind` decides whether it renders as a
// section header, a nav entry, a page-tree node, or the "New page" action.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { UIState, SidebarNode } from "../Types.slint";

export component SidebarItem inherits Rectangle {
    in property <SidebarNode> node;
    in property <int> index; // model row: the page-drag callbacks address rows by it

    property <bool> is-header: node.kind == "header";
    property <bool> is-page: node.kind == "page";
    property <bool> is-new-page: node.kind == "new-page";
    property <bool> renaming: is-page && UIState.renaming-id == node.id;
    // a page row or the Workspace header shows the "landing here" tint
    property <bool> drop-target: UIState.page-drop-target-id == node.id
        && (is-page || (is-header && node.id == -100));

    height: is-header ? 26px : 28px;
    border-radius: Theme.radius-sm;
    background: drop-target ? Colors.accent-soft
        : node.selected
        ? Colors.surface-selected
        : (ta.has-hover && !renaming ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        padding-left: Theme.spacing-xs + node.depth * 14px;
        padding-right: Theme.spacing-sm;
        cross-axis-alignment: center;

        if !is-header : Rectangle {
            width: 16px;
            height: 16px;
            // chevron area doubles as the expand/collapse click target;
            // leaves and the action row show their plain icon.
            if is-page && node.has-children : Rectangle {
                width: 16px;
                height: 16px;
                // A parent shows its own emoji here and gives the slot to the
                // expander while the pointer is on it. The second option -- a
                // slot for each -- pushed every parent's label one indent past
                // its children, which is how the tree lost its shape.
                if node.icon != "" : Text {
                    visible: !chev-ta.has-hover;
                    width: parent.width;
                    height: parent.height;
                    text: node.icon;
                    font-family: Typography.emoji-font;
                    font-size: Typography.size-icon-sidebar;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Icon {
                    visible: chev-ta.has-hover || node.icon == "";
                    width: 14px;
                    height: 14px;
                    size: 14px;
                    name: node.expanded ? "chevron-down" : "chevron-right";
                    color: chev-ta.has-hover ? Colors.text-primary : Colors.text-muted;
                }
                chev-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.node-expand-toggled(node.id);
                    }
                }
            }
            if !(is-page && node.has-children) : Rectangle {
                width: 16px;
                height: 16px;
                if node.icon != "" : Text {
                    width: parent.width;
                    height: parent.height;
                    text: node.icon;
                    font-family: Typography.emoji-font;
                    font-size: Typography.size-icon-sidebar;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if node.icon == "" : Icon {
                    width: 15px;
                    height: 15px;
                    size: 15px;
                    name: is-new-page ? "plus"
                        : node.kind == "favorite" ? "star"
                        : node.kind == "recent" ? "clock"
                        : "page";
                    color: is-new-page ? Colors.text-muted
                        : node.selected ? Colors.accent-text
                        : (ta.has-hover ? Colors.text-secondary : Colors.text-muted);
                }
            }
        }

        // label or inline rename input
        if renaming : Rectangle {
            height: 22px;
            border-radius: Theme.radius-xs;
            background: Colors.background;
            border-width: 1px;
            border-color: Colors.accent;
            rename-input := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                vertical-alignment: center;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: Colors.text-primary;
                selection-foreground-color: Colors.text-primary;
                selection-background-color: Colors.selection;
                single-line: true;
                text: node.label;
                accepted => {
                    UIState.rename-committed(node.id, self.text);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        UIState.rename-cancelled();
                        accept
                    } else {
                        reject
                    }
                }
                init => {
                    rename-input.focus();
                    rename-input.select-all();
                }
            }
        }
        if !renaming : Text {
            text: node.label;
            font-family: Typography.ui-font;
            font-size: is-header ? Typography.size-caption : Typography.size-ui;
            font-weight: is-header ? Typography.weight-semibold : Typography.weight-regular;
            color: is-header ? Colors.text-muted
                : is-new-page ? Colors.text-muted
                : node.selected ? Colors.text-primary
                : Colors.text-secondary;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // drag source for page rows: a press that moves past the threshold
    // starts the move-drag, a plain click still reaches the TouchArea below
    // (the block handle's pattern). Right-click passes through untouched.
    //
    // Touch mode drops it: inside the drawer a finger that lands on a row and
    // slides is scrolling the list, and a page drag is the same gesture — the
    // two used to be told apart by luck, which is how a slow slide became a
    // row pick. The phone's reorder path is the row menu's Move up / Move to.
    drag := DragArea {
        enabled: is-page && !renaming && !UIState.touch-mode;
        allow-move: true;
        data: UIState.page-drag-payload(node.id);
        drag-finished => {
            UIState.page-drop-target-id = -1;
        }
    }

    // ── long-press → page menu (touch only) ──────────────────────────────
    // A finger has no right button, so the row's context menu has no door on a
    // phone; a held press opens it, the same stand-in a held press on an editor
    // row uses for the ⋮⋮ menu (ADR-0097). Scroll defeats it three ways — a
    // move past the slop stops the timer, a flick that stole the press arrives
    // as `cancel`, and the tree's scroll y is compared against the value at
    // press-down in case the gesture was taken without either. The same slop
    // also keeps a slow slide from reading as a tap: a finger that travelled
    // that far was scrolling, whatever the list decided to call it.
    property <length> lp-x;
    property <length> lp-y;
    property <length> lp-scroll;
    // a fired long-press must swallow the click the lifting finger produces
    property <bool> lp-opened: false;
    // a slide the list did not claim must not read as a tap either
    property <bool> press-moved: false;

    ta := TouchArea {
        enabled: !renaming;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if (!UIState.touch-mode || (!lp-opened && !press-moved)) {
                UIState.sidebar-selected-id = node.id;
                UIState.node-clicked(node.id);
            }
            lp-opened = false;
            press-moved = false;
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.right
                && is-page) {
                UIState.node-context(node.id);
            }
            if (UIState.touch-mode && is-page && !renaming) {
                if (event.kind == PointerEventKind.down) {
                    lp-x = ta.mouse-x;
                    lp-y = ta.mouse-y;
                    lp-scroll = UIState.tree-viewport-y;
                    lp-opened = false;
                    press-moved = false;
                    lp-timer.stop();
                    lp-timer.start();
                }
                if (event.kind == PointerEventKind.cancel) {
                    // the flick took the press away (Slint resets the
                    // TouchArea and hands the gesture to the list's scroll)
                    lp-timer.stop();
                    lp-opened = false;
                    press-moved = false;
                }
                if (event.kind == PointerEventKind.up) {
                    lp-timer.stop();
                }
                if (event.kind == PointerEventKind.move
                    && (Math.abs(ta.mouse-x - lp-x) > 12px
                        || Math.abs(ta.mouse-y - lp-y) > 12px)) {
                    // a slide is a scroll, not a press held still
                    lp-timer.stop();
                    press-moved = true;
                }
            }
        }
    }

    lp-timer := Timer {
        interval: 500ms;
        // Timer defaults to running — a realized tree must not wake 500 ms
        // after being built (see EditorBlock's lp-timer)
        running: false;
        triggered => {
            lp-timer.stop();
            if (UIState.touch-mode
                && Math.abs(ta.mouse-x - lp-x) < 12px
                && Math.abs(ta.mouse-y - lp-y) < 12px
                && Math.abs(UIState.tree-viewport-y - lp-scroll) < 1px) {
                lp-opened = true;
                press-moved = true;
                // the same menu the desktop's right-click opens (and the TopBar
                // ⋯ button): rename, duplicate, move, favorite, templates, delete
                UIState.node-context(node.id);
            }
        }
    }

    // drop target: pages accept drops INTO them (the page becomes a child),
    // the Workspace header accepts a drop at the top level
    DropArea {
        can-drop(event) => {
            if (UIState.page-drag-hover(event.data, root.index)) {
                UIState.page-drop-target-id = node.id;
                DragAction.move
            } else {
                UIState.page-drop-target-id = -1;
                DragAction.none
            }
        }
        dropped(event) => {
            UIState.page-dropped(event.data, root.index);
            UIState.page-drop-target-id = -1;
            DragAction.move
        }
    }
}
