// Composition of the whole window body: title bar on top, sidebar + editor
// below, plus the scrim behind overlays. No business logic here — state flows
// through the UIState global, actions flow to the Rust controller.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { TopBar } from "./TopBar.slint";
import { IconButton } from "./IconButton.slint";
import { Sidebar } from "./Sidebar.slint";
import { Editor } from "./Editor.slint";
import { MobileBar } from "./MobileBar.slint";
import { UIState } from "../Types.slint";

export component AppShell inherits Rectangle {
    callback minimize-requested();
    callback maximize-requested();
    callback close-requested();

    property <bool> overlay-open: UIState.palette-open
        || UIState.search-open
        || UIState.menu-open
        || UIState.dialog-open
        || UIState.settings-open
        || UIState.link-open
        || UIState.slash-open
        || UIState.block-menu-open-id >= 0
        || UIState.icon-picker-open;

    // The three cards that block the page underneath them, as opposed to the
    // popups that hang off an element the user is already looking at. Only
    // these dim the page: an anchored menu with a dark band behind it reads
    // as a rendering fault, not as focus.
    property <bool> modal-open: UIState.dialog-open
        || UIState.settings-open
        || UIState.link-open;

    VerticalLayout {
        TopBar {
            minimize-requested => {
                root.minimize-requested();
            }
            maximize-requested => {
                root.maximize-requested();
            }
            close-requested => {
                root.close-requested();
            }
        }
        // the notice sits UNDER the title bar, not above it: an additive
        // band at the very top shrank the sidebar and clipped its last row
        // (A4 sweep, recovered scene)
        if UIState.db-notice != "" : Rectangle {
            height: 30px;
            background: Theme.dark ? #3d3517 : #f6e7b2;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-xs;
                spacing: Theme.spacing-sm;
                Text {
                    text: UIState.db-notice;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Theme.dark ? #e8d48a : #5a4a17;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                IconButton {
                    vertical-stretch: 0;
                    cross-axis-self-alignment: center;
                    icon-name: "x";
                    size: 22px;
                    clicked => {
                        UIState.close-db-notice();
                    }
                }
            }
        }
        HorizontalLayout {
            // The desktop rail. On a touch screen the same list rides over the
            // page as a drawer below instead, and then this element is not
            // instantiated at all: two `Sidebar`s would mean two `ListView`s
            // both holding `content-y <=> UIState.tree-viewport-y`, and the
            // scroll mirror would answer to whichever one last moved.
            if !UIState.touch-mode : Sidebar {}
            Editor {}
        }
        // The thumb-reachable row of a phone: nothing a finger has to travel to
        // the top of the window for. Its five actions are the desktop's own
        // keyboard chords and title-bar buttons, through the same UIState
        // callbacks, so no Rust is involved in this bar at all.
        if UIState.touch-mode : MobileBar {}
    }

    // The page list as a drawer, over the document rather than beside it. It is
    // outside the VerticalLayout on purpose: a drawer that costs the editor a
    // column is not a drawer.
    if UIState.touch-mode && UIState.sidebar-open : Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        clip: true;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Colors.scrim;
        }
        // A tap anywhere outside the panel closes it. Declared before the panel
        // so the panel is above it and keeps its own rows' clicks.
        drawer-close := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                UIState.toggle-sidebar();
            }
        }
        Rectangle {
            x: 0; y: 0;
            width: Theme.sidebar-width;
            height: parent.height;
            Sidebar {}
        }
    }

    // Scrim behind overlays. Menus/palette/search now auto-dismiss via
    // close-on-click-outside (the engine swallows the outside click while
    // a popup is open, so this TouchArea never sees it); the scrim remains
    // as a safety net for a UIState/popup desync: enabled while any
    // overlay flag is set, it dismisses everything on click.
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.overlay-open;
        // a modal over an undimmed page reads as a card pasted onto your
        // text (A4 LOW); an anchored popup keeps the page as-is
        background: root.modal-open ? Colors.scrim : transparent;
        scrim-ta := TouchArea {
            enabled: root.overlay-open;
            clicked => {
                UIState.palette-open = false;
                UIState.search-open = false;
                UIState.menu-open = false;
                UIState.dialog-open = false;
                UIState.settings-open = false;
                UIState.link-open = false;
                UIState.slash-open = false;
                UIState.block-menu-open-id = -1;
                UIState.icon-picker-open = false;
            }
        }
    }
}
